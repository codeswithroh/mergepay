{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mergepay",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*"], "html_handling": "drop-trailing-slash" },
  "observability": { "enabled": true },
  // Keep workers.dev on: every installed workflow sends merge proofs to this relayer URL.
  "workers_dev": true,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "FEED", "id": "fe7baa8405ab458d95a0213f119ed2c0" }],
  // Indexes MergePay events into KV every minute (Arc caps eth_getLogs at a few thousand blocks).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "CONTRACT": "0xcff79B144833b36ca53b310C1Ad7854AF9Ff9EeD",
    "DEPLOY_BLOCK": "22484520",
    "RPC_URL": "https://rpc.mainnet.arc.io",
    "RPC_FALLBACK": "https://arc.drpc.org",
    "RELAYER_URL": "https://mergepay.codeswithroh.workers.dev",
    "EXPLORER": "https://explorer.arc.io",
    "GITHUB_CLIENT_ID": "Ov23lisiDyuNgmPizE92",
    "WORKFLOW_REPO": "codeswithroh/mergepay",
    "WORKFLOW_REF": "codeswithroh/mergepay/.github/workflows/award.yml@refs/tags/v1"
  }
  // secrets: RELAYER_KEY, GITHUB_CLIENT_SECRET, SESSION_SECRET (wrangler secret put <NAME>)
}
