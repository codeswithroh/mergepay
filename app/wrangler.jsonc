{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mergepay",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"], "html_handling": "drop-trailing-slash" },
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "FEED", "id": "fe7baa8405ab458d95a0213f119ed2c0" }],
  // Indexes MergePay events into KV every minute (Arc caps eth_getLogs at a few thousand blocks).
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "CONTRACT": "0x0000000000000000000000000000000000000000",
    "DEPLOY_BLOCK": "0",
    "RPC_URL": "https://rpc.mainnet.arc.io",
    "EXPLORER": "https://explorer.arc.io",
    "WORKFLOW_REPO": "codeswithroh/mergepay",
    "WORKFLOW_REF": "codeswithroh/mergepay/.github/workflows/award.yml@refs/tags/v1"
  }
  // secret: RELAYER_KEY (wrangler secret put RELAYER_KEY)
}
